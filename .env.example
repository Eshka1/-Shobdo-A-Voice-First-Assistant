MONGO_URI=mongodb://localhost:27017/shobdo
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
ADMIN_BOOTSTRAP_EMAIL=

# Demo sign-in without a password (POST /api/auth/demo-login). Leave false unless you are
# running the demo: when true, anyone who can open the site becomes the shared demo user.
DEMO_LOGIN_ENABLED=false

# true ONLY when deployed behind one reverse proxy (Render, Railway, ...). Never on your laptop.
TRUST_PROXY=false
